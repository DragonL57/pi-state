// pi-permission-system global policy.
// Purpose: keep the duplicate built-in tools (edit, find, ls, grep) out of the
// active tool set. pi-permission-system re-activates every registered tool in
// before_agent_start unless it is denied here, which overrides the
// "defaultTools" list in settings.json. Edits go through pi-hashline-edit-pro
// (replace/insert); filesystem listing/search goes through bash + anchor_grep.
{
  "defaultPolicy": {
    "tools": "ask",
    "bash": "ask",
    "mcp": "ask",
    "skills": "ask",
    "special": "ask"
  },
  "tools": {
    "edit": "deny",
    "find": "deny",
    "ls": "deny",
    "grep": "deny",
    "powershell": "deny"
  }
}