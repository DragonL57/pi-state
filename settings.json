{
  "lastChangelogVersion": "1.5.2",
  "theme": "light/dark",
  "defaultProvider": "commandcode",
  "defaultModel": "deepseek/deepseek-v4.1-flash",
  "defaultThinkingLevel": "high",
  "defaultTools": [
    "read",
    "bash",
    "write"
  ],
  "packages": [
    "npm:pi-mcp-adapter",
    "npm:@juicesharp/rpiv-todo",
    "npm:pi-hashline-edit-pro",
    "npm:pi-ollama-cloud",
    "npm:pi-permission-system@0.8.0",
    "npm:@estebanforge/pi-codegraph-enhanced",
    "npm:@moejay/pi-state-sync",
    "npm:pi-commandcode-provider",
    "npm:@lll9p/pi-better-compaction",
    "npm:speak-like-you-eat"
  ],
  "observational-memory": {
    "observeAfterTokens": 10000,
    "reflectAfterTokens": 20000,
    "compactAfterTokens": 400000,
    "compactAfterTokensRatio": 0.5,
    "observationsPoolMaxTokens": 20000,
    "observationsPoolTargetTokens": 10000,
    "agentMaxTurns": 16,
    "model": {
      "provider": "commandcode",
      "id": "reflection/beam:free",
      "thinking": "high"
    },
    "passive": false,
    "debugLog": false
  },
  "quietStartup": true,
  "tuiMode": "fullscreen",
  "collapseChangelog": true,
  "markdown": {
    "mermaid": "streaming"
  },
  "hideThinkingBlock": false,
  "extensions": [
    "-builtin:mcp"
  ],
  "extensionChangelogVersions": {
    "{\"source\":\"npm:pi-mcp-adapter\",\"scope\":\"user\"}": "7.0.1",
    "{\"source\":\"npm:pi-ollama-cloud\",\"scope\":\"user\"}": "0.13.1",
    "{\"source\":\"npm:pi-permission-system@0.8.0\",\"scope\":\"user\"}": "0.8.0",
    "{\"source\":\"npm:@estebanforge/pi-codegraph-enhanced\",\"scope\":\"user\"}": "1.1.3",
    "{\"source\":\"npm:@moejay/pi-state-sync\",\"scope\":\"user\"}": "0.3.1",
    "{\"source\":\"npm:pi-commandcode-provider\",\"scope\":\"user\"}": "0.8.2"
  }
}